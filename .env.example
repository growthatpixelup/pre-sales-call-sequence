# Copy to .env.local and fill in.

# Supabase: Project Settings → API. Use the secret key (sb_secret_...) or the legacy
# service_role key. Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Secret you set on the Cal.com webhook. Required in production.
CAL_WEBHOOK_SECRET=

# Optional: Cal.com API key (Settings → Developer → API Keys) to import past bookings.
CAL_API_KEY=
# Optional: only import bookings for this event type id.
CAL_EVENT_TYPE_ID=

# Resend (resend.com → API Keys). Emails stay queued until these are set.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. Daksh @ PIXELUP <daksh@pixelup.in>
EMAIL_FROM=
# Where replies go. To see replies on the dashboard, use an address on a Resend receiving domain
# (Resend → Domains → enable Receiving, or your <id>.resend.app address).
EMAIL_REPLY_TO=
# Signing secret of the Resend webhook (Resend → Webhooks → add <your app>/api/webhooks/resend with
# the email.received event). Required in production for replies.
RESEND_WEBHOOK_SECRET=
# Optional: forward every reply here too, so it still reaches your inbox.
REPLY_FORWARD_TO=
# Optional: send every email to this address instead of the lead (for testing).
EMAIL_TEST_TO=
# Shared secret the Supabase scheduler sends to /api/cron/emails and /api/cron/buffer-sent.
# Any long random string.
CRON_SECRET=

# Slack "a call was booked" messages. Nothing is posted until both are set.
# Bot User OAuth Token (api.slack.com/apps → the app → OAuth & Permissions, xoxb-...) with the
# chat:write scope. Invite the bot to the channel if it's private.
SLACK_BOT_TOKEN=
# Channel id (channel → View channel details, at the bottom), e.g. #sales. A user id (U...)
# posts to that person's DM with the bot instead, for testing.
SLACK_SALES_CHANNEL=
# KAM: the bot above also reads #account-based-marketing. It needs the groups:history, users:read
# and users:read.email scopes and must be invited to the channel. Channel id, e.g. C0CEKRJCK5Z.
SLACK_KAM_CHANNEL=

# Claude reads KAM updates from Slack (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=

# Optional: login for /dashboard (browser prompt). Without a username, any username works.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional: time zone the dashboard shows times in, e.g. Asia/Kolkata. Defaults to the server's.
DASHBOARD_TIMEZONE=

# --- "Post is live" Slack alerts (X via Typefully, LinkedIn via Buffer) ---
# Signing secret of the Typefully webhook (Typefully → Settings → API → webhook).
TYPEFULLY_WEBHOOK_SECRET=
# Buffer API key (publish.buffer.com/settings/api). Used by /api/cron/buffer-sent.
BUFFER_API_KEY=
# Buffer organization id. Find it with: node scripts/buffer-ids.mjs
BUFFER_ORG_ID=
# Comma-separated Buffer channel ids of the LinkedIn channels to watch (from scripts/buffer-ids.mjs).
BUFFER_LINKEDIN_CHANNEL_IDS=
# Slack incoming webhook URL for the dedicated alerts channel. Secret: never commit or log it.
SLACK_WEBHOOK_URL=
# "true" logs the Slack message instead of sending it. Use while testing.
DRY_RUN=

# Content OS MCP server (/api/mcp) so Claude can read swipe-file outliers. Any long random string;
# the endpoint is off until it's set. Setup: docs/content-os.md.
CONTENT_MCP_TOKEN=
